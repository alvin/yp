# Supabase connection for the app.
#
# Only PUBLIC_* values belong here. They are read by `$env/static/public` and
# baked into the browser bundle at build time, so they must be safe to publish.
# The anon/publishable key is safe on its own: `0004_security.sql` gives the
# anonymous role no grants on `ypl`, so it can read nothing until a staff user
# signs in.
#
# NEVER add a service-role or secret key here or to a Cloudflare build
# variable — the build inlines what it can see, and it would ship to the
# browser with full RLS bypass.

# Local development (supabase start)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Staging/production builds set these as Build variables in the Cloudflare
# dashboard rather than committing them:
#   PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
#   PUBLIC_SUPABASE_ANON_KEY=<publishable key>
