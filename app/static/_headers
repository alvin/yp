/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # Staging carries the real Access import, including guest PII. Keep it out of
  # search indexes and AI crawlers regardless of what robots.txt says.
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# Hashed build assets are immutable; the HTML shell must never be cached or
# clients pin to a stale bundle after a deploy.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
